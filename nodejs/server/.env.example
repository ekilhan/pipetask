# Node.js Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
SERVER_PORT=5000

# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432

# Notes:
# - For local development: DB_HOST=localhost
# - For Docker: DB_HOST=postgresql
# - For K8s: DB credentials are managed by K8s secrets
# - NEVER commit the actual .env file to git!
